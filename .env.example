# Copy this file to .env.local and fill in keys from Supabase → Project Settings → API.
# Use the publishable key (sb_publishable_...) or legacy anon JWT — not the service_role key.
VITE_SUPABASE_URL=https://wrbphdcgzcdesgslijuz.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Edge function secrets — set these in Supabase, not in this file:
#   supabase secrets set TWILIO_ACCOUNT_SID=... TWILIO_AUTH_TOKEN=... \
#     TWILIO_WHATSAPP_FROM="whatsapp:+14155238886" \
#     RESEND_API_KEY=... RESEND_FROM="FabricPort <notifications@yourdomain.com>"
#
# TWILIO_*  → WhatsApp notification fan-out (send-notification function)
# RESEND_*  → Email notification fan-out (send-notification function)
# When unset, notifications still work in-app; WhatsApp/email are skipped.
# ---------------------------------------------------------------------------
